<?xml version="1.0" encoding="utf-8"?>
<!--
  audio_service resolves notification and media-control icons by name at
  runtime (for example "drawable/ic_stop"). Because those references are
  strings in Dart, the resource shrinker considers them unused and strips
  them, which makes release builds fail with:
  "You must specify an icon resource id to build a CustomAction".
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/*" />
